# Infrastructure and secrets only. Project definitions (slug, repository,
# setup/checks, stacks, e2e, deploy targets, provider IDs/origins) live in
# sdlc.config.ts; Settings shows each project's rev.
PORT=4000
DATABASE_URL=postgres://sdlc:sdlc@localhost:5959/sdlc

# Set to true to run with scripted in-memory fakes (no Docker, GitHub or OpenCode required).
SDLC_FAKES=false
# Set to false to leave seeded Tasks untouched on boot while building the web app.
SDLC_RESUME_ON_START=true
# Optional override for the local config path (defaults to <repo-root>/sdlc.config.ts).
SDLC_CONFIG_PATH=
# Global cap on concurrent active Tasks across all projects (protects Docker RAM/CPU).
MAX_GLOBAL_CONCURRENT_TASKS=4

# Default tokens referenced by sdlc.config.ts (per-project overrides can name other env vars).
GITHUB_TOKEN=
OPENCODE_API_KEY=
MODEL_DEVELOPER=muse-spark-1.3-contributor-free
MODEL_FAST=muse-spark-1.3-contributor-free

# Optional deploy provider credentials (serviceId/workerName/origin live per-project in sdlc.config.ts).
RENDER_API_KEY=
CF_API_TOKEN=
CF_ACCOUNT_ID=

CONTROL_PLANE_URL=http://localhost:3000
SANDBOX_IMAGE=sdlc-ai-sandbox:local
DOCKER_BIN=docker
ARTIFACTS_DIR=./artifacts
