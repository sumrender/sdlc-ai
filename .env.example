PORT=4000
DATABASE_URL=postgres://sdlc:sdlc@localhost:5959/sdlc

# Set to true to run the API against in-memory fakes (no Docker, GitHub or OpenCode Zen needed).
SDLC_FAKES=false
# Set to false to leave seeded Tasks untouched on boot while building the web app.
SDLC_RESUME_ON_START=true

GITHUB_TOKEN=
GITHUB_OWNER=sumrender
GITHUB_REPO=meme
GITHUB_DEFAULT_BRANCH=main

# OpenCode Zen key (get one at https://opencode.ai/auth). The free-tier
# muse-spark models work with no billing attached.
OPENCODE_API_KEY=
MODEL_DEVELOPER=muse-spark-1.3-contributor-free
MODEL_FAST=muse-spark-1.3-contributor-free

RENDER_API_KEY=
RENDER_SERVICE_ID=

CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_WORKER_NAME=

# Public origins of the Project's staging deployments (shown on the STAGING card).
FE_ORIGIN=
BE_ORIGIN=

# Where the web app is served; used for links in Issues and PRs.
CONTROL_PLANE_URL=http://localhost:3000

SANDBOX_IMAGE=sdlc-ai-sandbox:local
DOCKER_BIN=docker
ARTIFACTS_DIR=./artifacts
