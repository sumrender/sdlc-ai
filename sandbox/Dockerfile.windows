# Windows-dev variant of the Sandbox runtime image (minimal opencode runner:
# node + Playwright browsers via the base image, git, pnpm and opencode only;
# all other toolchains come from the Project Manifest's `setup` commands).
# The official OpenCode image is Alpine/musl and its binary does not run on this glibc base,
# so install the glibc build from the GitHub release instead.
# Auto-selected on win32 (see select-dockerfile.mjs); override with DOCKERFILE=Dockerfile.windows.
# Manual build: docker build -f sandbox/Dockerfile.windows -t sdlc-ai-sandbox:local sandbox
FROM mcr.microsoft.com/playwright:v1.62.1-noble

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# The official OpenCode image is Alpine/musl and its binary does not run on this glibc base,
# so install the glibc build from the GitHub release instead.
ARG OPENCODE_VERSION=1.18.31
RUN curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-linux-x64.tar.gz" \
  | tar -xz -C /usr/local/bin opencode \
  && chmod +x /usr/local/bin/opencode \
  && opencode --version

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    npm_config_cache=/cache/npm \
    NUGET_PACKAGES=/cache/nuget

# Keep in sync with sandbox/Dockerfile: expose Playwright's Chromium as
# CHROME_BIN (wrapped with --no-sandbox) so Karma's ChromeHeadless works without
# each project shipping its own workaround. Fails the build loudly if no working
# Chrome is found, because a missing CHROME_BIN skips frontend unit tests silently.
RUN set -eu; \
  CHROME=""; \
  for candidate in /ms-playwright/chromium-*/chrome-linux*/chrome; do \
    [ -x "$candidate" ] || continue; \
    CHROME="$candidate"; \
    break; \
  done; \
  if [ -z "$CHROME" ]; then \
    echo "FATAL: no Chromium at /ms-playwright/chromium-*/chrome-linux*/chrome" >&2; \
    ls -la /ms-playwright >&2 || true; \
    exit 1; \
  fi; \
  ln -sf "$CHROME" /opt/chrome; \
  printf '#!/bin/sh\nexec /opt/chrome --no-sandbox "$@"\n' > /usr/local/bin/chrome; \
  chmod +x /usr/local/bin/chrome; \
  echo "CHROME_BIN -> $CHROME"; \
  /usr/local/bin/chrome --version
ENV CHROME_BIN=/usr/local/bin/chrome

WORKDIR /workspace
