{
  "name": "sdlc-ai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @sdlc-ai/api db:generate",
    "db:migrate": "pnpm --filter @sdlc-ai/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
